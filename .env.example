# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: API key from resend.com to send inquiry notification emails.
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=""

# INQUIRY_RECEIVER_EMAIL: Destination inbox for incoming inquiries (e.g. tolgakinas@gmail.com or ops@baobabdmc.com)
INQUIRY_RECEIVER_EMAIL="tolgakinas@gmail.com"

# RESEND_FROM_EMAIL: Sender address verified in Resend (default: onboarding@resend.dev for test mode, or e.g. Baobab DMC <inquiries@yourdomain.com>)
RESEND_FROM_EMAIL="Baobab DMC <onboarding@resend.dev>"

